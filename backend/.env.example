# Copy to .env and fill in. .env is gitignored.
# JWT signing key — generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Google Gemini API key for the /api/chat assistant (optional; chat returns 503 if unset)
GEMINI_API_KEY=
# GST SETU (government GST API) key — optional. If set, real GST data is fetched;
# otherwise the platform falls back to deterministic synthetic data (SANDBOX mode).
GST_SETU_API_KEY=
# GST_SETU_BASE_URL=https://api.gstsetu.in

# Only needed to run migrate_to_tidb.py / seed_banker.py against the live TiDB
# instance. In production these are set in Railway's dashboard, not here.
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:4000/finhealth?ssl_verify_cert=true&ssl_verify_identity=true
# TIDB_HOST=
# TIDB_USER=
# TIDB_PASSWORD=
# DEMO_PASSWORD=  # optional — auto-generated and printed once if unset
