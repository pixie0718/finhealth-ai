# Copy to .env and fill in. .env is gitignored.
# JWT signing key — generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Google Gemini API key for the /api/chat assistant (optional; chat returns 503 if unset)
GEMINI_API_KEY=
# GST SETU (government GST API) key — optional. If set, real GST data is fetched;
# otherwise the platform falls back to deterministic synthetic data (SANDBOX mode).
GST_SETU_API_KEY=
# GST_SETU_BASE_URL=https://api.gstsetu.in
