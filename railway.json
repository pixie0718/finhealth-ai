{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "buildCommand": "echo 'Docker build'"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "cd backend && uvicorn main:app --host 0.0.0.0 --port 8000",
    "restartPolicyMaxRetries": 10
  }
}
